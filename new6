#include <stdio.h>

/* Function prototypes */
int input_validation(int x, int y);

int treasure_check(int guess_x, int guess_y,
                   int treasure_x, int treasure_y);

void display_board_or_error(int input_error,
                            int selected_x,
                            int selected_y);
void display_hit_or_miss(int input_error, int get_treasure);
int check_end_game(int attempt, int get_treasure);
void display_final_result(int get_treasure);

int main(void)
{
    int mycolumn = 0;
    int myrow = 0;
    int guesscolumn = 0;
    int guessrow = 0;
    int input_error = 0;
    int get_treasure = 0;
    int attempt = 0;
    int end_game = 0;

    /* Ask for the treasure column */
    printf("Enter column number between 0 - 9: ");

    if (scanf_s("%d", &mycolumn) != 1)
    {
        printf("This is not a number.\n");
        return 0;
    }

    /* Ask for the treasure row */
    printf("Enter row number between 0 - 9: ");

    if (scanf_s("%d", &myrow) != 1)
    {
        printf("This is not a number.\n");
        return 0;
    }

    input_error = input_validation(mycolumn, myrow);

    if (input_error == 1)
    {
        printf("ERROR! Number outside of range.\n");
        return 0;
    }

    printf("\n(%d,%d) is the coordinate with the treasure.\n",
           mycolumn, myrow);

    while (end_game == 0)
    {
        /* Ask the player for a guess */
        printf("\nEnter column number between 0 - 9: ");

        if (scanf_s("%d", &guesscolumn) != 1)
        {
            printf("This is not a number.\n");
            return 0;
        }

        printf("Enter row number between 0 - 9: ");

        if (scanf_s("%d", &guessrow) != 1)
        {
            printf("This is not a number.\n");
            return 0;
        }

        attempt++;

        /* Function 1 */
        input_error = input_validation(
            guesscolumn,
            guessrow
        );

        /* Function 3 */
        display_board_or_error(
            input_error,
            guesscolumn,
            guessrow
        );

        /* Do not check for treasure if the input is invalid */
        if (input_error == 0)
        {
        /* Function 2 */
        get_treasure = treasure_check(
            guesscolumn,
            guessrow,
            mycolumn,
            myrow
        );
    }
    else
    {
        get_treasure = 0;
    }
        display_hit_or_miss(
         input_error,
         get_treasure
        );

    printf("This was your %d/20 attempt.\n", attempt);

/* Function 5 */
end_game = check_end_game(
    attempt,
    get_treasure
);
        }
   display_final_result(get_treasure);
    
    return 0;
}


/* Function 1: validate coordinates */
int input_validation(int x, int y)
{
    if (x < 0 || x > 9 || y < 0 || y > 9)
    {
        return 1;
    }

    return 0;
}


/* Function 2: check for treasure */
int treasure_check(int guess_x, int guess_y,
                   int treasure_x, int treasure_y)
{
    if (guess_x == treasure_x &&
        guess_y == treasure_y)
    {
        return 1;
    }

    return 0;
}


/* Function 3: display the board or an error */
void display_board_or_error(int input_error,
                            int selected_x,
                            int selected_y)
{
    int row;
    int column;

    if (input_error == 1)
    {
        printf("ERROR! Number outside of range.\n");
        return;
    }

    for (row = -1; row <= 9; row++)
    {
        for (column = -1; column <= 9; column++)
        {
            if (row == -1 && column == -1)
            {
                printf("  ");
            }
            else if (row == -1)
            {
                printf("%d ", column);
            }
            else if (column == -1)
            {
                printf("%d", row);
            }
            else if (column == selected_x &&
                     row == selected_y)
            {
                printf(" ■");
            }
            else
            {
                printf(" □");
            }
        }

        printf("\n");
    }
}

/* Function 4: display hit or miss */
void display_hit_or_miss(int input_error, int get_treasure)
{
    if (input_error == 1)
    {
        return;
    }

    if (get_treasure == 1)
    {
        printf("あたり\n");
    }
    else
    {
        printf("はずれ\n");
    }
}

/* Function 5: determine whether the game should end */
int check_end_game(int attempt, int get_treasure)
{
    if (attempt >= 20 || get_treasure == 1)
    {
        return 1;
    }

    return 0;
}

/* Function 6: display the final result */
void display_final_result(int get_treasure)
{
    if (get_treasure == 1)
    {
        printf("\nCOMPLETE\n");
    }
    else
    {
        printf("\nGAMEOVER\n");
    }
}
