#include <stdio.h>

int row = 0;
int column = 0;
int mycolumn = 0;
int myrow = 0;
int guesscolumn = 0;
int guessrow = 0;
int i = 0;
int end_game = 0;

/*check that the user is entering a number in range*/
int check_input()
{
    if (guesscolumn > 9 || guesscolumn < 0 ||
        guessrow > 9 || guessrow < 0)
    {
        printf("ERROR! Number outside of range.\n");
        return 0;
    }

    return 1;
}

/* check if the user found the treasure*/
int check_treasure()
{
    if (guesscolumn == mycolumn && guessrow == myrow)
    {
        return 1;
    }

    return 0;
}

/*board display*/
void display_board()
{
 for (int row = -1; row <= 9; row++) {
    for (int column = -1; column <= 9; column++) {
         if (row == -1 && column == -1) {
            printf("  ");
         }else if (row == -1) {
            printf("%d ", column);
         }else if (column == -1) {
            printf("%d", row);
         }else if (column == mycolumn && row == myrow) {
             printf(" ■");
                        }
         else {
             printf(" □");
         }
      }
     printf("\n");
     }
}

/* display hit or miss */
void display_judgement()
{
    if (check_treasure() == 1)
    {
        printf("あたり\n");
    }
    else
    {
        printf("はずれ\n");
    }
}

/* check if game should end */
int check_end_game()
{
    if (check_treasure() == 1)
    {
        return 1;
    }

    if (i >= 20)
    {
        return 1;
    }

    return 0;
}


/* display final result */
void display_final_result()
{
    printf("game over\n");
}

int main()
{
     printf("Enter column number between 0 - 9:");
    if (scanf("%d", &mycolumn) != 1) {
        printf("This is not a number.\n");
        return 0;
    }
    /*ask for row number*/
    printf("Enter row number between 0 - 9:");
    if (scanf("%d", &myrow) != 1)
    {
        printf("This is not a number.\n");
        return 0;
    }
    /*check if the number is in range between 0-9*/
    if (mycolumn > 9 || mycolumn < 0 || myrow > 9 || myrow < 0) {
        printf("ERROR! Number outside of range.");
        return 0;
    }

    /* main game loop */
    while (end_game == 0)
    {
        printf("Enter guess column number between 0 - 9:");

        if (scanf("%d", &guesscolumn) != 1)
        {
            printf("This is not a number.\n");
            return 0;
        }


        printf("Enter guess row number between 0 - 9:");

        if (scanf("%d", &guessrow) != 1)
        {
            printf("This is not a number.\n");
            return 0;
        }


        if (check_input() == 0)
        {
            continue;
        }


        i++;


        display_board();

        display_judgement();

        end_game = check_end_game();
}
    
      display_final_result();


    return 0;
}
