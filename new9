#include <stdio.h>

#define TRE_COUNT 10

int row = 0;
int column = 0;

int tre_x[10];
int tre_y[10];

int guesscolumn = 0;
int guessrow = 0;

int i = 0;
int end_game = 0;
int get_treasure = 0;

int get_comp[10];

int score = 0;
int gold = 0; 


/* QUESTION 7
   Initialise treasure positions and collect flags
*/

typedef struct {
    int tre_x; 
    int tre_y; 
    int gold;
    int get_comp;
} obj;

void init_treasure()
{
    obj s1 = { 5, 8, 3, 0 };
    obj s2 = { 3, 9, 2, 0 };
    obj s3 = { 5, 8, 3, 0 };
    obj s4 = { 0, 5, 1, 0 };
    obj s5 = { 5, 9, 2, 0 };
    obj s6 = { 1, 7, 4, 0 };
    obj s7 = { 2, 8, 1, 0 };
    obj s8 = { 4, 6, 1, 0 };
    obj s9 = { 3, 7, 2, 0 };
    obj s10 = { 2, 5, 1, 0 };

    for (int j = 0; j < TRE_COUNT; j++)
    {
        get_comp[j] = 0;
    }
}

/* QUESTION 8
   Get x and y from the keyboard.
   Check that both values are between 0 and 9.
   Return the result as a flag.
*/
int input_position(int* guesscolumn, int* guessrow)
{
    printf("Enter guess column number between 0 - 9:");

    if (scanf_s("%d", guesscolumn) != 1)
    {
        printf("This is not a number.\n");
        return 0;
    }


    printf("Enter guess row number between 0 - 9:");

    if (scanf_s("%d", guessrow) != 1)
    {
        printf("This is not a number.\n");
        return 0;
    }


    if (*guesscolumn > 9 || *guesscolumn < 0 ||
        *guessrow > 9 || *guessrow < 0)
    {
        printf("ERROR! Number outside of range.\n");
        return 0;
    }


    return 1;
}


/* check if the user found a treasure */
int check_treasure()
{
    int j;

    for (j = 0; j < TRE_COUNT; j++)
    {
        if (guesscolumn == tre_x[j] &&
            guessrow == tre_y[j] &&
            get_comp[j] == 0)
        {
            get_comp[j] = 1;

            return 1;
        }
    }

    return 0;
}


/* board display */
void display_board()
{
    for (int row = -1; row <= 9; row++)
    {
        for (int column = -1; column <= 9; column++)
        {
            if (row == -1 && column == -1)
            {
                printf("  ");
            }
            else if (row == -1)
            {
                printf("%d ", column);
            }
            else if (column == -1)
            {
                printf("%d", row);
            }
            else if (column == guesscolumn &&
                row == guessrow)
            {
                printf(" ■");
            }
            else
            {
                printf(" □");
            }
        }

        printf("\n");
    }
}


/* display hit or miss */
void display_judgement()
{
    if (check_treasure() == 1)
    {
        printf("あたり\n");
        score = score + obj.gold; 
    }
    else
    {
        printf("はずれ\n");
    }
}


/* check if game should end */
int check_end_game()
{
    if (score >= TRE_COUNT)
    {
        return 1;
    }

    if (i >= 20)
    {
        return 1;
    }

    return 0;
}


/* display final result */
void display_final_result()
{
    printf("game over\n");
    printf("score = %d\n", score);
}


int main()
{
    int flag = 0;

    /* QUESTION 7 */
    init_treasure(tre_x, tre_y, get_comp);


    /* main game loop */
    while (end_game == 0)
    {
        /* QUESTION 8 */
        flag = input_position(&guesscolumn, &guessrow);


        if (flag == 0)
        {
            continue;
        }


        i++;


        display_board();

        display_judgement();

        end_game = check_end_game();


        printf("score = %d\n", score);
        printf("guess = %d / 20\n\n", i);
    }


    display_final_result();


    return 0;
}
